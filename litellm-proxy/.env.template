# =========================================================================
# LiteLLM Proxy Gateway Configuration - Template
# Copy this file to '.env' and fill in your actual credentials.
# DO NOT commit the '.env' file to your version control repository!
# =========================================================================

# --- Administrative Security ---
# Set the master admin key for managing virtual keys (must start with "sk-")
LITELLM_MASTER_KEY=sk-cirqle-admin-master-key-change-me

# Encryption salt for keys in SQLite (generate a long random string)
LITELLM_SALT_KEY=cirqle-salt-key-long-random-string-change-me

# --- LLM Providers Credentials ---
# OpenAI API Key (Required for openai-mini & openai-mini-batch)
OPENAI_API_KEY=sk-proj-YOUR_OPENAI_API_KEY_HERE

# Google Gemini API Key (Required for the `fast` tier)
GEMINI_API_KEY=AIzaSyYOUR_GEMINI_API_KEY_HERE

# DeepSeek API Key (Required for the `reasoning` and `draft` tiers)
# This is the key you already have. It lives ONLY here, server-side, and is
# never exposed to the browser — the frontend only ever holds a per-user
# virtual key minted by the proxy.
DEEPSEEK_API_KEY=sk-YOUR_DEEPSEEK_API_KEY_HERE

# --- Infrastructure Setup (Defaults) ---
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
DATABASE_URL=sqlite:////data/litellm.db
PORT=4000

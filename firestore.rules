    function isValidJobHistoryUpdate() {
      let data = request.resource.data;
      return data.keys().hasOnly([
               'role', 'company', 'location', 'startedAt', 'endedAt',
               'current', 'sourceType', 'sourceId', 'correctionOf',
               'supersededBy', 'recordedAt', 'createdAt', 'closedAt',
               'immutableProvenance'
             ])
             && data.role == resource.data.role
             && data.company == resource.data.company
             && data.location == resource.data.location
             && data.startedAt == resource.data.startedAt
             && data.sourceType == resource.data.sourceType
             && data.sourceId == resource.data.sourceId
             && data.correctionOf == resource.data.correctionOf
             && data.recordedAt == resource.data.recordedAt
             && data.createdAt == resource.data.createdAt
             && data.immutableProvenance

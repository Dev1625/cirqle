             && data.current == false
             && data.endedAt is timestamp
             && isNullableString(data.supersededBy, 300)
             && data.closedAt == request.time
             && data.diff(resource.data).affectedKeys().hasOnly([
               'current', 'endedAt', 'supersededBy', 'closedAt'
             ]);
    }

    function isValidBrowserContactEvent(userId) {
      let data = request.resource.data;
      return data.keys().hasOnly([
               'contactId', 'type', 'actorUid', 'sourceType',
               'sourceId', 'payload', 'occurredAt', 'immutable'
             ])
             && data.keys().hasAll([
               'contactId', 'type', 'actorUid', 'sourceType',
               'sourceId', 'payload', 'occurredAt', 'immutable'
             ])
             && data.actorUid == userId
             && data.contactId is string
             && data.contactId.size() > 0
             && data.contactId.size() <= 300
             && data.type in [
                'profile-updated', 'archived', 'restored',
                'soft-deleted', 'purge-requested'
              ]
             && data.sourceType == 'contact-management'
             && isNullableString(data.sourceId, 300)
             && data.payload is map
             && data.payload.size() <= 20
             && !data.payload.keys().hasAny([
               'primaryContactId', 'duplicateContactId',
               'mergedIntoContactId'
             ])
             && data.immutable == true
             && data.occurredAt == request.time;
    }

    function isValidPrivacyPolicyEvent(userId) {
      let data = request.resource.data;
      let policy = data.policy;
      return data.keys().hasOnly([
               'schemaVersion', 'kind', 'policy', 'actorUid', 'recordedAt'
             ])
             && data.keys().hasAll([
               'schemaVersion', 'kind', 'policy', 'actorUid', 'recordedAt'
             ])
             && data.schemaVersion == 1
             && data.kind == 'privacy-policy-replaced'
             && data.actorUid == userId
             && data.recordedAt == request.time
             && policy is map
             && policy.keys().hasOnly([
               'schemaVersion', 'defaultRetentionMode',
               'defaultRetentionDays', 'defaultAIUse', 'boundaries'
             ])
             && policy.keys().hasAll([
               'schemaVersion', 'defaultRetentionMode',
               'defaultRetentionDays', 'defaultAIUse', 'boundaries'
             ])
             && policy.schemaVersion == 1
             && policy.defaultRetentionMode in [
               'forever', 'days', 'delete-on-disconnect'
             ]
             && (
               (policy.defaultRetentionMode == 'days'
                && policy.defaultRetentionDays is int
                && policy.defaultRetentionDays >= 1
                && policy.defaultRetentionDays <= 3650)
               || (policy.defaultRetentionMode != 'days'
                   && policy.defaultRetentionDays == null)
             )
             && policy.defaultAIUse in ['allow', 'never']
             && policy.boundaries is list
             && policy.boundaries.size() <= 200;
    }

    function isValidCommitmentFeedbackEvent(userId, eventId) {
      let data = request.resource.data;
      let baseKeys = [
        'id', 'commitmentId', 'actorUid', 'occurredAt', 'source',
        'kind', 'recordedAt'
      ];
      return data.keys().hasAll(baseKeys)
             && data.id == eventId
             && eventId.matches('^[A-Za-z0-9._:-]{1,160}$')
             && data.commitmentId is string
             && data.commitmentId.matches('^[A-Za-z0-9._:-]{1,160}$')
             && data.actorUid == userId
             && data.occurredAt is string
             && data.occurredAt.size() > 0
             && data.occurredAt.size() <= 64
             && data.source == 'user-explicit'
             && data.recordedAt == request.time
             && exists(
               /databases/$(database)/documents/users/$(userId)/commitments/$(data.commitmentId)
             )
             && linkedContactAcceptsWrites(
               userId,
               get(
                 /databases/$(database)/documents/users/$(userId)/commitments/$(data.commitmentId)
               ).data
             )
             && (
               (data.kind == 'completed'
                && data.keys().hasOnly(baseKeys))
               || (data.kind == 'reality-reviewed'
                   && data.keys().hasOnly(
                     baseKeys.concat(['reality'])
                   )
                   && data.reality in ['real', 'not-real'])
               || (data.kind == 'snoozed'
                   && data.keys().hasOnly(
                     baseKeys.concat(['snoozedUntil'])
                   )
                   && data.snoozedUntil is string
                   && data.snoozedUntil.size() > 0
                   && data.snoozedUntil.size() <= 64)
               || (data.kind == 'dismissed'
                   && data.keys().hasOnly(
                     baseKeys.concat(['reason', 'note'])
                   )
                   && data.reason in [
                     'false-positive', 'duplicate', 'already-completed',
                     'not-actionable', 'no-longer-relevant', 'other'
                   ]
                   && isNullableString(data.note, 500))
               || (data.kind == 'relationship-outcome-recorded'
                   && data.keys().hasOnly(
                     baseKeys.concat(['outcome', 'note'])
                   )
                   && data.outcome in [
                     'improved', 'unchanged', 'worsened'
                   ]
                   && isNullableString(data.note, 500))
             );
    }

    function isValidPurgeRequest(userId, requestId) {
      let data = request.resource.data;
      let plan = data.plan;
      return data.keys().hasOnly([
               'actorUid', 'contactId', 'status', 'plan',
               'requestedAt', 'requiresServerExecution'
             ])
             && data.keys().hasAll([
               'actorUid', 'contactId', 'status', 'plan',
               'requestedAt', 'requiresServerExecution'
             ])
             && data.actorUid == userId
             && data.contactId == requestId
             && requestId.size() > 0
             && requestId.size() <= 300
             && data.status == 'queued'
             && data.requiresServerExecution == true
             && data.requestedAt == request.time
             && plan is map
             && plan.keys().hasOnly([
               'contactId', 'eligible', 'eligibleAt', 'collectionPaths',
               'relatedCollections', 'requiresServerExecution'
             ])
             && plan.keys().hasAll([
               'contactId', 'eligible', 'eligibleAt', 'collectionPaths',
               'relatedCollections', 'requiresServerExecution'
             ])
             && plan.contactId == requestId
             && plan.eligible == true
             && plan.eligibleAt is timestamp
             && plan.eligibleAt <= request.time
             && plan.collectionPaths == [
               'users/' + userId + '/contacts/' + requestId + '/facts',
               'users/' + userId + '/contacts/' + requestId + '/jobHistory',
               'users/' + userId + '/contacts/' + requestId
             ]
             && plan.relatedCollections == [
               'note', 'outreach', 'commitment',
               'commitment-feedback', 'thread', 'voice-enrichment',
               'connection', 'contact-event'
             ]
             && plan.requiresServerExecution == true;
    }

    function isValidMergeRecoveryRequest(userId, requestId) {
      let data = request.resource.data;
      return data.keys().hasOnly([
               'operationId', 'primaryContactId', 'duplicateContactId',
               'actorUid', 'status', 'requestedAt',
               'requiresServerExecution', 'recoveryProtocolVersion'
             ])
             && data.keys().hasAll([
               'operationId', 'primaryContactId', 'duplicateContactId',
               'actorUid', 'status', 'requestedAt',
               'requiresServerExecution', 'recoveryProtocolVersion'
             ])
             && data.operationId == requestId
             && data.actorUid == userId
             && data.primaryContactId is string
             && data.primaryContactId.size() > 0
             && data.primaryContactId.size() <= 300
             && data.duplicateContactId is string
             && data.duplicateContactId.size() > 0
             && data.duplicateContactId.size() <= 300
             && data.primaryContactId != data.duplicateContactId
             && data.status == 'queued'
             && data.requiresServerExecution == true
             && data.recoveryProtocolVersion == 1
             && data.requestedAt == request.time;
    }

    function isSafePublicUrl(value) {
      // Public card links open in a visitor's browser. Restrict them to HTTPS
      // so a malicious/modified client cannot persist javascript:, data:, or
      // insecure transport URLs into an otherwise trusted Cirqle page.
      return value is string
             && value.size() <= 2048
             && value.matches(
               '^https://[^/@?#\\s]+(?::[0-9]{1,5})?(?:/[^\\s]*)?(?:\\?[^\\s#]*)?(?:#[^\\s]*)?$'
             );
    }

    function isValidPublicLink(value) {
      return value is map
             && value.keys().hasOnly(['label', 'url'])
             && value.keys().hasAll(['label', 'url'])
             && isSafePublicText(value.label, 80)
             && value.label.size() > 0
             && isSafePublicUrl(value.url);
    }

    function isValidPublicLinks(values) {
      // Rules do not support a general list loop. The product caps this small
      // display list, so each possible slot is checked explicitly.
      return values is list
             && values.size() <= 6
             && (values.size() < 1 || isValidPublicLink(values[0]))
             && (values.size() < 2 || isValidPublicLink(values[1]))
             && (values.size() < 3 || isValidPublicLink(values[2]))
             && (values.size() < 4 || isValidPublicLink(values[3]))
             && (values.size() < 5 || isValidPublicLink(values[4]))
             && (values.size() < 6 || isValidPublicLink(values[5]));
    }

    function isValidPublicCard(cardId) {
      // This collection is deliberately public. Keep its schema explicit so
      // a future client refactor cannot accidentally denormalise a secret
      // profile field (for example apiKey or integration metadata) into it.
      return request.resource.data.keys().hasOnly([
               'cardId', 'ownerUid', 'mode', 'accent', 'layout', 'name',
               'role', 'company', 'intro', 'portedUrl', 'links', 'email',
               'published', 'updatedAt'
             ])
             && request.resource.data.keys().hasAll([
               'cardId', 'ownerUid', 'mode', 'accent', 'layout', 'name',
               'role', 'company', 'intro', 'portedUrl', 'links', 'email',
               'published', 'updatedAt'
             ])
             && request.resource.data.cardId == cardId
             && isValidCardId(cardId)
             && request.resource.data.ownerUid is string
             && request.resource.data.mode in ['ai', 'custom', 'ported']
             && request.resource.data.accent in [
                  'oxblood', 'slate', 'moss', 'brass', 'clay', 'ink'
                ]
             && request.resource.data.layout in ['compact', 'expanded']
             && isSafePublicText(request.resource.data.name, 120)
             && request.resource.data.name.size() > 0
             && isSafePublicText(request.resource.data.role, 160)
             && isSafePublicText(request.resource.data.company, 160)
             && isSafePublicText(request.resource.data.intro, 240)
             && (request.resource.data.portedUrl == null
                 || isSafePublicUrl(request.resource.data.portedUrl))
             && isValidPublicLinks(request.resource.data.links)
             && isSafePublicEmail(request.resource.data.email)
             && request.resource.data.published is bool
             && request.resource.data.updatedAt is timestamp
             && request.resource.data.updatedAt == request.time;
    }

    // All private CRM state is scoped beneath an active authenticated owner's
    // uid. A server-pending account gets no CRM access; once active, an owner
    // whose email is still unverified may read existing data but cannot write.
    match /users/{userId} {
      allow read: if isOwner(userId);
      allow create: if false;
      allow update: if canWritePrivateData(userId)
                    && isValidUserRoot(userId);
      // Full account deletion is a server-only orchestration that removes
      // credentials and integrations before this root document.
      allow delete: if false;

      match /contactEvents/{eventId} {
        allow read: if isOwner(userId);
        allow create: if canWritePrivateData(userId)
                      && isValidBrowserContactEvent(userId)
                      && contactAcceptsLinkedWrites(
                        userId,
                        request.resource.data.contactId
                      );
        allow update, delete: if false;
      }

      match /privacyPolicyEvents/{eventId} {
        allow read: if isOwner(userId);
        allow create: if canWritePrivateData(userId)
                      && isValidPrivacyPolicyEvent(userId);
        allow update, delete: if false;
      }

      match /commitmentFeedbackEvents/{eventId} {
        allow read: if isOwner(userId);
        allow create: if canWritePrivateData(userId)
                      && isValidCommitmentFeedbackEvent(
                        userId,
                        eventId
                      );
        allow update, delete: if false;
      }

      // Privacy-safe activity registry. It records a random tab-session ID
      // and coarse browser/platform labels, never an IP address, token,
      // fingerprint, full user agent, or credential.
      match /sessions/{sessionId} {
        function validSessionShape() {
          return request.resource.data.keys().hasOnly([
                   'userId', 'sessionId', 'deviceLabel', 'browser',
                   'platform', 'createdAt', 'lastSeenAt', 'expiresAt'
                 ])
                 && request.resource.data.keys().hasAll([
                   'userId', 'sessionId', 'deviceLabel', 'browser',
                   'platform', 'createdAt', 'lastSeenAt', 'expiresAt'
                 ])
                 && request.resource.data.userId == userId
                 && request.resource.data.sessionId == sessionId
                 && sessionId.matches('^[A-Za-z0-9_-]{20,80}$')
                 && request.resource.data.deviceLabel is string
                 && request.resource.data.deviceLabel.size() <= 100
                 && request.resource.data.browser is string
                 && request.resource.data.browser.size() <= 50
                 && request.resource.data.platform is string
                 && request.resource.data.platform.size() <= 50
                 && request.resource.data.createdAt is timestamp
                 && request.resource.data.lastSeenAt is timestamp
                 && request.resource.data.expiresAt is timestamp
                 && request.resource.data.expiresAt > request.time
                 && request.resource.data.expiresAt
                    < request.time + duration.value(91, 'd');
        }

        allow read: if isOwner(userId);
        allow create: if canWritePrivateData(userId)
                      && validSessionShape()
                      && request.resource.data.createdAt == request.time
                      && request.resource.data.lastSeenAt == request.time;
        allow update: if canWritePrivateData(userId)
                      && validSessionShape()
                      && request.resource.data.createdAt
                         == resource.data.createdAt
                      && request.resource.data.lastSeenAt == request.time
                      && request.resource.data.diff(resource.data)
                         .affectedKeys().hasOnly([
                           'deviceLabel', 'browser', 'platform',
                           'lastSeenAt', 'expiresAt'
                         ]);
        allow delete: if canWritePrivateData(userId);
      }

      // A browser may enqueue its own already-validated recovery operation.
      // Only the Admin worker may change status or delete the request.
      match /contactPurgeRequests/{requestId} {
        allow read: if isOwner(userId);
        allow create: if canWritePrivateData(userId)
                      && isValidPurgeRequest(userId, requestId);
        allow update, delete: if false;
      }

      match /contactMergeRecoveryRequests/{requestId} {
        allow read: if isOwner(userId);
        allow create: if canWritePrivateData(userId)
                      && isValidMergeRecoveryRequest(userId, requestId);
        allow update, delete: if false;
      }

      // A merge changes contacts, root references, nested immutable history,
      // and audit records together. Only the authenticated Admin endpoint may
      // author or change this transaction receipt.
      match /contactMergeOperations/{operationId} {
        allow read: if isOwner(userId);
        allow create, update, delete: if false;
      }

      match /contacts/{contactId} {
        allow read: if isOwner(userId);
        allow create:
          if canWritePrivateData(userId)
             && isValidBrowserContactCreate(userId);
        allow update:
          if canWritePrivateData(userId)
             && isValidBrowserContactUpdate(userId);
        allow delete: if false;

        match /facts/{factId} {
          allow read: if isOwner(userId);
          allow create: if canWritePrivateData(userId)
                        && isValidTemporalFactCreate(
                          userId,
                          contactId,
                          factId
                        )
                        && contactAcceptsLinkedWrites(userId, contactId);
          allow update: if canWritePrivateData(userId)
                        && isValidTemporalFactUpdate()
                        && contactAcceptsLinkedWrites(userId, contactId);
          allow delete: if false;
        }

        match /jobHistory/{entryId} {
          allow read: if isOwner(userId);
          allow create: if canWritePrivateData(userId)
                        && isValidJobHistoryCreate(userId)
                        && contactAcceptsLinkedWrites(userId, contactId);
          allow update: if canWritePrivateData(userId)
                        && isValidJobHistoryUpdate()
                        && contactAcceptsLinkedWrites(userId, contactId);
          allow delete: if false;
        }
      }

      match /notes/{noteId} {
        allow read: if isOwner(userId);
        allow create:
          if canWritePrivateData(userId)
             && isValidBrowserNoteCreate(userId, noteId)
             && contactAcceptsLinkedWrites(
               userId,
               request.resource.data.contactId
             );
        allow update:
          if canWritePrivateData(userId)
             && contactAcceptsLinkedWrites(
               userId,
               resource.data.contactId
             )
             && contactAcceptsLinkedWrites(
               userId,
               request.resource.data.contactId
             )
             && (
               isValidSensitiveNoteMigration(userId, noteId)
               || isValidVoiceEnrichmentUpdate(userId, noteId)
             );
        allow delete:
          if canWritePrivateData(userId)
             && resource.data.noteSchemaVersion == 2
             && resource.data.userId == userId
             && resource.data.recordType == 'ai-tag'
             && resource.data.source == 'ai-tag-extraction'
             && resource.data.privacySourceType == 'user-input'
             && resource.data.sourceId == noteId
             && resource.data.factIds is list
             && resource.data.factIds.size() == 0
             && contactAcceptsLinkedWrites(
               userId,
               resource.data.contactId
             );
      }

      match /outreaches/{outreachId} {
        allow read: if isOwner(userId);
        allow create:
          if canWritePrivateData(userId)
             && isValidOutreachDocument(
               userId,
               request.resource.data
             )
             && contactAcceptsLinkedWrites(
               userId,
               request.resource.data.contactId
             )
             && browserOutreachProofCreateAllowed(request.resource.data)
             && browserMergeMetadataCreateAllowed(
               request.resource.data
             );
        allow update:
          if canWritePrivateData(userId)
             && isValidOutreachDocument(
               userId,
               request.resource.data
             )
             && contactAcceptsLinkedWrites(
               userId,
               resource.data.contactId
             )
             && contactAcceptsLinkedWrites(
               userId,
               request.resource.data.contactId
             )
             && request.resource.data.userId == resource.data.userId
             && request.resource.data.contactId == resource.data.contactId
             && browserOutreachProofUpdateAllowed()
             && browserMergeMetadataUpdateAllowed('outreaches');
        allow delete: if false;
      }

      match /commitments/{commitmentId} {
        allow read: if isOwner(userId);
        allow create:
          if canWritePrivateData(userId)
             && isValidCommitmentDocument(request.resource.data)
             && contactAcceptsLinkedWrites(
               userId,
               request.resource.data.contactId
             )
             && browserMergeMetadataCreateAllowed(request.resource.data);
        allow update:
          if canWritePrivateData(userId)
             && isValidCommitmentDocument(request.resource.data)
             && contactAcceptsLinkedWrites(
               userId,
               resource.data.contactId
             )
             && contactAcceptsLinkedWrites(
               userId,
               request.resource.data.contactId
             )
             && request.resource.data.contactId == resource.data.contactId
             && request.resource.data.createdAt == resource.data.createdAt
             && browserMergeMetadataUpdateAllowed('commitments');
        allow delete: if false;
      }

      match /templates/{templateId} {
        allow read: if isOwner(userId);
        allow create:
          if canWritePrivateData(userId)
             && isValidTemplateDocument(userId, request.resource.data)
             && request.resource.data.createdAt == request.time
             && request.resource.data.updatedAt == request.time;
        allow update:
          if canWritePrivateData(userId)
             && isValidTemplateDocument(userId, request.resource.data)
             && request.resource.data.userId == resource.data.userId
             && request.resource.data.createdAt == resource.data.createdAt
             && request.resource.data.updatedAt == request.time;
        allow delete: if false;
      }

      match /integrations/{provider} {
        allow read: if isOwner(userId);
        // Live connection state, provider cursors, and verification status
        // are written only by the Admin integration service. The browser can
        // exercise the intentionally synthetic preview state.
        allow create, update:
          if canWritePrivateData(userId)
             && isValidMockIntegration(provider, request.resource.data)
             && request.resource.data.updatedAt == request.time
             && (
               !exists(
                 /databases/$(database)/documents/users/$(userId)/integrations/$(provider)
               )
               || resource.data.mode == 'mock'
             );
        allow delete: if false;
      }

      match /threads/{threadId} {
        allow read: if isOwner(userId);
        // Provider-verified live threads and their poll cursor are server
        // receipts. Only deterministic preview threads are browser mutable.
        allow create:
          if canWritePrivateData(userId)
             && isValidMockThread(
               userId,
               threadId,
               request.resource.data
             )
             && contactAcceptsLinkedWrites(
               userId,
               request.resource.data.contactId
             )
             && browserMergeMetadataCreateAllowed(request.resource.data);
        allow update:
          if canWritePrivateData(userId)
             && resource.data.mode == 'mock'
             && isValidMockThread(
               userId,
               threadId,
               request.resource.data
             )
             && request.resource.data.contactId == resource.data.contactId
             && request.resource.data.threadId == resource.data.threadId
             && request.resource.data.createdAt == resource.data.createdAt
             && contactAcceptsLinkedWrites(
               userId,
               resource.data.contactId
             )
             && contactAcceptsLinkedWrites(
               userId,
               request.resource.data.contactId
             )
             && browserMergeMetadataUpdateAllowed('threads');
        allow delete: if false;
      }

      match /settings/{settingId} {
        allow read: if isOwner(userId);
        allow create, update:
          if settingId == 'privacy'
             && canWritePrivateData(userId)
             && isValidPrivacyPolicy(request.resource.data)
             && request.resource.data.updatedAt == request.time;
        allow delete: if false;
      }

      match /contactBulkOperations/{operationId} {
        allow read: if isOwner(userId);
        allow create:
          if canWritePrivateData(userId)
             && isValidBulkOperationCreate(userId);
        allow update:
          if canWritePrivateData(userId)
             && isValidBulkOperationUpdate(userId);
        allow delete: if false;
      }

      // Event mode is stored on the exact user root. No current product flow
      // writes a second, mutable event-session document.
      match /eventSessions/{eventSessionId} {
        allow read: if isOwner(userId);
        allow create, update, delete: if false;
      }

      match /voiceEnrichmentJobs/{noteId} {
        allow read: if isOwner(userId);
        allow create:
          if canWritePrivateData(userId)
             && isValidVoiceEnrichmentJob(
               noteId,
               request.resource.data
             )
             && contactAcceptsLinkedWrites(
               userId,
               request.resource.data.contactId
             )
             && exists(
               /databases/$(database)/documents/users/$(userId)/notes/$(noteId)
             )
             && get(
               /databases/$(database)/documents/users/$(userId)/notes/$(noteId)
             ).data.contactId == request.resource.data.contactId
             && browserMergeMetadataCreateAllowed(request.resource.data);
        allow update:
          if canWritePrivateData(userId)
             && isValidVoiceEnrichmentJob(
               noteId,
               request.resource.data
             )
             && request.resource.data.noteId == resource.data.noteId
             && request.resource.data.contactId == resource.data.contactId
             && request.resource.data.contactName
                == resource.data.contactName
             && contactAcceptsLinkedWrites(
               userId,
               resource.data.contactId
             )
             && contactAcceptsLinkedWrites(
               userId,
               request.resource.data.contactId
             )
             && browserMergeMetadataUpdateAllowed(
               'voiceEnrichmentJobs'
             );
        allow delete: if false;
      }

      match /connections/{connectionId} {
        allow read: if isOwner(userId);
        allow create:
          if canWritePrivateData(userId)
             && isValidConnectionDocument(
               userId,
               connectionId,
               request.resource.data
             )
             && request.resource.data.createdAt == request.time
             && request.resource.data.updatedAt == request.time
             && connectionAcceptsLinkedWrites(
               userId,
               'connections',
               request.resource.data
             );
        allow update:
          if canWritePrivateData(userId)
             && isValidConnectionDocument(
               userId,
               connectionId,
               request.resource.data
             )
             && request.resource.data.userId == resource.data.userId
             && request.resource.data.sourceId == resource.data.sourceId
             && request.resource.data.targetId == resource.data.targetId
             && request.resource.data.createdAt == resource.data.createdAt
             && request.resource.data.updatedAt == request.time
             && connectionAcceptsLinkedWrites(
               userId,
               'connections',
               resource.data
             )
             && connectionAcceptsLinkedWrites(
               userId,
               'connections',
               request.resource.data
             );
        allow delete: if false;
      }
    }

    // OAuth refresh tokens are server-only. Cloud Functions use the Admin SDK
    // and bypass these client rules. Nothing in this collection is returned
    // to a browser, including to the token owner.
    match /oauthTokens/{userId} {
      allow read, write: if false;

      match /{credentialDocument=**} {
        allow read, write: if false;
      }
    }

    // OAuth state is an opaque, short-lived, single-use server record. The
    // browser receives only the random state value; it cannot read, mint, or
    // consume the Firestore binding that contains UID, provider, and PKCE.
    match /_oauthStates/{stateId} {
      allow read, write: if false;
    }

    // Opaque account-deletion receipts are Admin-only. They intentionally
    // contain no user identifier or CRM content and expire operationally.
    match /_accountDeletionReceipts/{receiptId} {
      allow read, write: if false;
    }

    // Cirqle's own OAuth authorization server state, for MCP clients.
    //
    // Registered clients, pending authorization codes, and refresh-token
    // records are all Admin-only. A browser that could read _oauthCodes would
    // hold codes mid-flight for other sessions; one that could write
    // _oauthClients could register a client with a redirect URI it controls and
    // turn the authorize endpoint into an open redirector. Nothing here is ever
    // needed by the app itself — the consent screen talks to the API, not to
    // these documents.
    match /_oauthClients/{clientId} {
      allow read, write: if false;
    }
    match /_oauthCodes/{codeHash} {
      allow read, write: if false;
    }
    match /_oauthTokens/{tokenHash} {
      allow read, write: if false;
    }

    // Durable session-revocation and deletion locks are server-owned. Client
    // rules read them to authorize requests, but no browser may create,
    // reactivate, weaken, or remove its own lock.
    match /_accountSecurity/{userId} {
      allow read, write: if false;
    }

    // The one deliberately public surface. A published card is an opt-in,
    // denormalised snapshot containing only the fields validated above. A
    // retired card remains readable by its owner for editing, but not by a
    // stranger who retained the old link.
    match /cards/{cardId} {
      allow get: if resource.data.published == true
                 || isPublicCardOwner();
      allow list: if false;

      allow create: if request.auth != null
                    && request.auth.uid == request.resource.data.ownerUid
                    && hasActiveAccount(
                      request.resource.data.ownerUid
                    )
                    && hasVerifiedEmail()
                    && isValidPublicCard(cardId);

      allow update: if isPublicCardOwner()
                    && hasVerifiedEmail()
                    && request.resource.data.ownerUid == resource.data.ownerUid
                    && request.resource.data.cardId == resource.data.cardId
                    && isValidPublicCard(cardId);

      allow delete: if isPublicCardOwner();

      // Reverse capture. Public writes go through /api/cards/capture, where
      // App Check, per-visitor/per-card throttling, a honeypot, deduplication,
      // and the card's current publication status are enforced. The Admin SDK
      // bypasses these rules; browsers cannot bypass that server boundary.
      match /captures/{captureId} {
        function parentCard() {
          return get(
            /databases/$(database)/documents/cards/$(cardId)
          );
        }

        function isCaptureOwner() {
          return request.auth != null
                 && request.auth.uid == parentCard().data.ownerUid
                 && hasActiveAccount(
                   parentCard().data.ownerUid
                 );
        }

        allow create: if false;
        allow read, delete: if isCaptureOwner();
        allow update: if false;
      }
    }
  }
}

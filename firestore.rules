             ])
             && data.userId == userId
             && data.sourceId is string
             && data.sourceId.size() > 0
             && data.sourceId.size() <= 300
             && data.targetId is string
             && data.targetId.size() > 0
             && data.targetId.size() <= 300
             && data.sourceId != data.targetId
             && data.type == 'user-recorded introduction path'
             && data.inferred == false
             && data.direction in ['directed', 'mutual']
             && data.weight is int
             && data.weight >= 1
             && data.weight <= 5
             && data.strength is number
             && data.strength >= 0.2
             && data.strength <= 1
             && data.willingness in [

    function isBoundedBase64(value, minLength, maxLength) {
      return value is string
             && value.size() >= minLength
             && value.size() <= maxLength
             && value.matches('^[A-Za-z0-9+/]+={0,2}$');
    }

    function isValidSensitiveEnvelopeV1(value) {
      return value is map
             && value.keys().hasOnly([
               'schemaVersion', 'algorithm', 'kdf', 'iterations',
               'salt', 'iv', 'ciphertext'
             ])
             && value.keys().hasAll([
               'schemaVersion', 'algorithm', 'kdf', 'iterations',
               'salt', 'iv', 'ciphertext'
             ])
             && value.schemaVersion == 1
             && value.algorithm == 'AES-GCM'
             && value.kdf == 'PBKDF2-SHA256'
             && value.iterations == 310000
             && isBoundedBase64(value.salt, 24, 24)
             && isBoundedBase64(value.iv, 16, 16)
             && isBoundedBase64(value.ciphertext, 24, 106712);
    }

    function isValidSensitiveEnvelopeV2(value, userId, noteId) {
      return value is map
             && value.keys().hasOnly([
               'schemaVersion', 'algorithm', 'kdf', 'iterations',
               'salt', 'iv', 'ciphertext', 'aad'
             ])
             && value.keys().hasAll([
               'schemaVersion', 'algorithm', 'kdf', 'iterations',
               'salt', 'iv', 'ciphertext', 'aad'
             ])
             && value.schemaVersion == 2
             && value.algorithm == 'AES-GCM'
             && value.kdf == 'PBKDF2-SHA256'
             && value.iterations == 310000
             && isBoundedBase64(value.salt, 24, 24)
             && isBoundedBase64(value.iv, 16, 16)
             && isBoundedBase64(value.ciphertext, 24, 106712)
             && value.aad is map
             && value.aad.keys().hasOnly([
               'version', 'scope', 'userId', 'noteId'
             ])
             && value.aad.keys().hasAll([
               'version', 'scope', 'userId', 'noteId'
             ])
             && value.aad.version == 1
             && value.aad.scope == 'user-note'
             && value.aad.userId == userId
             && value.aad.noteId == noteId;
    }

    function isValidQuickNoteCreate(userId, noteId) {
      let data = request.resource.data;
      return data.keys().hasOnly(noteBaseKeys())
             && data.keys().hasAll(noteBaseKeys())
             && isValidNoteBase(userId, noteId, data)
             && data.recordType == 'note'
             && data.source == 'quick-note'
             // 'agent' marks a note an MCP agent wrote, so the owner can retire
             // everything an AI added in one action rather than one note at a
             // time — a note's sourceId must equal its own id, so per-import
             // revocation is not otherwise expressible. See noteSourceType in
             // source-retention.js, which must list it too.
             && data.privacySourceType in ['note', 'agent']
             && data.content is string
             && data.content.size() > 0
             && data.content.size() <= 20000
             && data.sensitive == false;
    }

    function isValidSensitiveNoteCreate(userId, noteId) {
      let data = request.resource.data;
      return data.keys().hasOnly(
               noteBaseKeys().concat(['encryptedContent'])
             )
             && data.keys().hasAll(
               noteBaseKeys().concat(['encryptedContent'])
             )
             && isValidNoteBase(userId, noteId, data)
             && data.recordType == 'note'
             && data.source == 'sensitive-note'
             && data.privacySourceType == 'note'
             && data.content == null
             && data.sensitive == true
             && data.aiAllowed == false
             && data.factIds.size() == 0
             && isValidSensitiveEnvelopeV2(
               data.encryptedContent,
               userId,
               noteId
             );
    }

    function isValidMeetingNoteCreate(userId, noteId) {
      let data = request.resource.data;
      return data.keys().hasOnly(
               noteBaseKeys().concat(['occurredAt', 'meetingAt'])
             )
             && data.keys().hasAll(
               noteBaseKeys().concat(['occurredAt', 'meetingAt'])
             )
             && isValidNoteBase(userId, noteId, data)
             && data.recordType == 'meeting'
             && data.source == 'meeting-log'
             // See the quick-note rule: 'agent' keeps AI-written meeting logs
             // revocable as one group.
             && data.privacySourceType in ['meeting', 'agent']
             && data.content is string
             && data.content.size() > 0
             && data.content.size() <= 70000
             && data.sensitive == false
             && data.occurredAt is timestamp
             && data.meetingAt == data.occurredAt
             && data.observedAt == data.occurredAt
             && data.factIds.size() <= 4;
    }

    function isValidVoiceNoteShape(userId, noteId, data) {
      return data.keys().hasOnly(
               noteBaseKeys()
                 .concat(noteServerMetadataKeys())
                 .concat([
                   'meetingTitle', 'aiSummary', 'aiSummaryGrounding'
                 ])
             )
             && data.keys().hasAll(
               noteBaseKeys().concat(['meetingTitle'])
             )
             && isValidNoteBase(userId, noteId, data)
             && data.recordType == 'voice'
             && data.source == 'voice-memo'
             && data.privacySourceType == 'voice'
             && data.content is string
             && data.content.size() > 0
             && data.content.size() <= 12000
             && data.sensitive == false
             && isNullableString(data.meetingTitle, 500)
             && data.factIds.size() <= 2
             && (!('aiSummary' in data)
                 || (data.aiSummary is string
                     && data.aiSummary.size() > 0
                     && data.aiSummary.size() <= 160))
             && (!('aiSummaryGrounding' in data)
                 || isValidPrivateGrounding(data.aiSummaryGrounding));
    }

    function isValidVoiceNoteCreate(userId, noteId) {
      return request.resource.data.keys().hasOnly(
               noteBaseKeys().concat(['meetingTitle'])
             )
             && isValidVoiceNoteShape(
               userId,
               noteId,
               request.resource.data
             );
    }

    function isValidReplyNoteCreate(userId, noteId) {
      let data = request.resource.data;
      return data.keys().hasOnly(
               noteBaseKeys().concat([
                 'replyTargetOutreachId', 'replyTargetThreadId',
                 'aiFeature', 'aiProvenance'
               ])
             )
             && data.keys().hasAll(
               noteBaseKeys().concat([
                 'replyTargetOutreachId', 'replyTargetThreadId',
                 'aiFeature', 'aiProvenance'
               ])
             )
             && isValidNoteBase(userId, noteId, data)
             && data.recordType == 'reply'
             && data.source == 'pasted-reply'
             && data.privacySourceType == 'reply'
             && data.content is string
             && data.content.size() > 0
             && data.content.size() <= 5000
             && data.sensitive == false
             && data.aiAllowed == true
             && data.factIds.size() == 0
             && isNullableString(data.replyTargetOutreachId, 300)
             && isNullableString(data.replyTargetThreadId, 300)
             && data.aiFeature == 'contact.reply.process'
             && isValidNoteAIProvenance(
               data.aiProvenance,
               'contact.reply.process'
             );
    }

    function isValidAITagNoteCreate(userId, noteId) {
      let data = request.resource.data;
      return data.keys().hasOnly(
               noteBaseKeys().concat(['aiFeature', 'aiProvenance'])
             )
             && data.keys().hasAll(
               noteBaseKeys().concat(['aiFeature', 'aiProvenance'])
             )
             && isValidNoteBase(userId, noteId, data)
             && data.recordType == 'ai-tag'
             && data.source == 'ai-tag-extraction'
             && data.privacySourceType == 'user-input'
             && data.content is string
             && data.content.size() > 0
             && data.content.size() <= 2000
             && data.sensitive == false
             && data.aiAllowed == false
             && data.factIds.size() == 0
             && data.aiFeature == 'contact.tags.extract'
             && isValidNoteAIProvenance(
               data.aiProvenance,
               'contact.tags.extract'
             );
    }

    function isValidBrowserNoteCreate(userId, noteId) {
      let data = request.resource.data;
      return data.createdAt == request.time
             && data.updatedAt == request.time
             && (
               isValidQuickNoteCreate(userId, noteId)
               || isValidSensitiveNoteCreate(userId, noteId)
               || isValidMeetingNoteCreate(userId, noteId)
               || isValidVoiceNoteCreate(userId, noteId)
               || isValidReplyNoteCreate(userId, noteId)
               || isValidAITagNoteCreate(userId, noteId)
             );
    }

    function isLegacySensitiveNote(data, userId) {
      return data.userId == userId
             && data.contactId is string
             && data.source == 'sensitive-note'
             && data.content == null
             && data.sensitive == true
             && data.aiAllowed == false
             && isValidSensitiveEnvelopeV1(data.encryptedContent);
    }

    function isValidSensitiveNoteMigration(userId, noteId) {
      let data = request.resource.data;
      return isLegacySensitiveNote(resource.data, userId)
             && data.diff(resource.data).affectedKeys().hasOnly([
               'encryptedContent', 'encryptionMigratedAt', 'updatedAt'
             ])
             && data.userId == resource.data.userId
             && data.contactId == resource.data.contactId
             && data.source == resource.data.source
             && data.content == resource.data.content
             && data.sensitive == resource.data.sensitive
             && data.aiAllowed == resource.data.aiAllowed
             && data.createdAt == resource.data.createdAt
             && data.updatedAt == request.time
             && data.encryptionMigratedAt == request.time
             && isValidSensitiveEnvelopeV2(
               data.encryptedContent,
               userId,
               noteId
             );
    }

    function isLegacyVoiceNote(data, userId) {
      return data.userId == userId
             && data.contactId is string
             && data.recordType == 'voice'
             && data.source == 'voice-memo'
             && data.content is string
             && data.content.size() > 0
             && data.content.size() <= 12000
             && data.sensitive == false;
    }

    function isValidVoiceEnrichmentUpdate(userId, noteId) {
      let data = request.resource.data;
      return (
               isValidVoiceNoteShape(userId, noteId, resource.data)
               || isLegacyVoiceNote(resource.data, userId)
             )
             && data.diff(resource.data).affectedKeys().hasOnly([
               'aiSummary', 'aiSummaryGrounding', 'updatedAt'
             ])
             && data.userId == resource.data.userId
             && data.contactId == resource.data.contactId
             && data.recordType == resource.data.recordType
             && data.source == resource.data.source
             && data.content == resource.data.content
             && data.sensitive == resource.data.sensitive
             && data.aiAllowed == resource.data.aiAllowed
             && data.createdAt == resource.data.createdAt
             && data.updatedAt == request.time
             && data.aiSummary is string
             && data.aiSummary.size() > 0
             && data.aiSummary.size() <= 160
             && data.aiSummaryGrounding is map
             && isValidPrivateGrounding(data.aiSummaryGrounding)
             && data.aiSummaryGrounding.usedSourceIds.hasAny([
               'note-' + noteId
             ]);
    }

    function isValidTemporalFactCorrection(userId, contactId, factId) {
      let data = request.resource.data;
      return (data.correctionOf == null
              && data.sourceType != 'user-correction')
             || (
               data.sourceType == 'user-correction'
               && data.sourceId == data.correctionOf
               && data.correctionOf != factId
               && exists(
                 /databases/$(database)/documents/users/$(userId)/contacts/$(contactId)/facts/$(data.correctionOf)
               )
               && get(
                 /databases/$(database)/documents/users/$(userId)/contacts/$(contactId)/facts/$(data.correctionOf)
               ).data.predicate == data.predicate
               && get(
                 /databases/$(database)/documents/users/$(userId)/contacts/$(contactId)/facts/$(data.correctionOf)
               ).data.current == true
               && getAfter(
                 /databases/$(database)/documents/users/$(userId)/contacts/$(contactId)/facts/$(data.correctionOf)
               ).data.current == false
               && getAfter(
                 /databases/$(database)/documents/users/$(userId)/contacts/$(contactId)/facts/$(data.correctionOf)
               ).data.supersededBy == factId
             );
    }

    function isValidBrowserFactProvenance() {
      let data = request.resource.data;
      let profilePredicate = data.predicate in [
        'identity.name', 'identity.email', 'identity.phone',
        'identity.company', 'identity.role', 'identity.location',
        'identity.linkedinUrl', 'identity.summary', 'identity.industry',
        'identity.subIndustry', 'identity.school', 'identity.seniority',
        'relationship.tier', 'relationship.whyTheyMatter',
        'relationship.connectionSource', 'relationship.tags'
      ];
      return data.sourceId is string
             && data.sourceId.size() > 0
             && data.sourceId.size() <= 300
             && (
               ((data.sourceType == 'profile'
                 || data.sourceType == 'import')
                && profilePredicate)
               || (data.sourceType == 'note'
                   && data.predicate == 'relationship.note')
               || (data.sourceType == 'meeting'
                   && data.predicate in [
                     'meeting.date', 'meeting.discussed',
                     'meeting.promised', 'meeting.nextSteps'
                   ])
               || (data.sourceType == 'voice'
                   && data.predicate in [
                     'relationship.voiceMemo', 'meeting.title'
                   ])
               || (data.sourceType == 'public-card-capture'
                   && data.predicate in [
                     'identity.name', 'identity.company', 'identity.email',
                     'relationship.connectionSource', 'relationship.event',
                     'relationship.captureEvidence'
                   ])
               || (data.sourceType == 'outreach'
                   && data.predicate in [
                     'outreach.subject', 'outreach.status',
                     'outreach.outcome', 'outreach.context'
                   ])
               || data.sourceType == 'user-correction'
             );
    }

    function isValidTemporalFactCreate(userId, contactId, factId) {
      let data = request.resource.data;
      return data.keys().hasOnly([
               'predicate', 'value', 'normalizedValue', 'sourceType',
               'sourceId', 'observedAt', 'confidence', 'current',
               'aiAllowed', 'correctionOf', 'supersededBy', 'createdAt',
               'updatedAt'
             ])
             && data.keys().hasAll([
               'predicate', 'value', 'normalizedValue', 'sourceType',
               'sourceId', 'observedAt', 'confidence', 'current',
               'aiAllowed', 'correctionOf', 'supersededBy', 'createdAt',
               'updatedAt'
             ])
             && data.predicate is string
             && data.predicate.size() > 0
             && data.predicate.size() <= 200
             && data.value is string
             && data.value.size() > 0
             && data.value.size() <= 20000
             && data.normalizedValue is string
             && data.normalizedValue.size() <= 20000
             && data.sourceType in [
                'profile', 'import', 'agent', 'note', 'meeting', 'outreach',
                'voice', 'public-card-capture', 'user-correction'
              ]
             && isNullableString(data.sourceId, 300)
             && data.observedAt is timestamp
             && data.confidence is number
             && data.confidence >= 0
             && data.confidence <= 1
             && data.current == true
             && data.aiAllowed is bool
             && isNullableString(data.correctionOf, 300)
             && data.supersededBy == null
             && data.createdAt == request.time
             && data.updatedAt == request.time
             && isValidBrowserFactProvenance()
             && isValidTemporalFactCorrection(
               userId,
               contactId,
               factId
             );
    }

    function isValidTemporalFactUpdate() {
      let data = request.resource.data;
      return data.keys().hasOnly([
               'predicate', 'value', 'normalizedValue', 'sourceType',
               'sourceId', 'observedAt', 'confidence', 'current',
               'aiAllowed', 'correctionOf', 'supersededBy', 'createdAt',
               'updatedAt', 'supersededAt', 'privacyUpdatedAt',
               'contactMergeOperationId', 'migratedFromContactId',
               'migratedFromContactName', 'migratedFromHadContactName',
               'migratedFromPath', 'originalHistoryLinks',
               'originalCurrent', 'mergeHistorical',
               'migrationRecordedAt', 'mergeRecoveryOperationId',
               'contactMergeRecoveryOperationId'
             ])
             && data.predicate == resource.data.predicate
             && data.value == resource.data.value
             && data.normalizedValue == resource.data.normalizedValue
             && data.sourceType == resource.data.sourceType
             && data.sourceId == resource.data.sourceId
             && data.observedAt == resource.data.observedAt
             && data.confidence == resource.data.confidence
             && data.correctionOf == resource.data.correctionOf
             && data.createdAt == resource.data.createdAt
             && data.current is bool
             && data.aiAllowed is bool
             && isNullableString(data.supersededBy, 300)
             && (
               (resource.data.current == true
                && data.current == true
                && data.supersededBy == null
                && !('supersededAt' in data))
               || (resource.data.current == true
                   && data.current == false
                   && data.supersededBy is string
                   && data.supersededBy.size() > 0
                   && data.supersededAt == request.time)
               || (resource.data.current == false
                   && data.current == false
                   && data.supersededBy == resource.data.supersededBy
                   && data.supersededAt == resource.data.supersededAt)
             )
             && data.updatedAt == request.time
             && (!('supersededAt' in data)
                 || data.supersededAt == request.time
                 || (('supersededAt' in resource.data)
                     && data.supersededAt
                        == resource.data.supersededAt))
             && (!('privacyUpdatedAt' in data)
                 || data.privacyUpdatedAt == request.time
                 || (('privacyUpdatedAt' in resource.data)
                     && data.privacyUpdatedAt
                        == resource.data.privacyUpdatedAt))
             && request.resource.data.diff(resource.data)
                .affectedKeys().hasOnly([
                  'current', 'aiAllowed', 'supersededBy', 'supersededAt',
                  'privacyUpdatedAt', 'updatedAt'
                ]);
    }

    function isValidJobHistoryCreate(userId) {
      let data = request.resource.data;
      return data.keys().hasOnly([
               'role', 'company', 'location', 'startedAt', 'endedAt',
               'current', 'sourceType', 'sourceId', 'correctionOf',
               'supersededBy', 'recordedAt', 'createdAt',
               'immutableProvenance'
             ])
             && data.keys().hasAll([
               'role', 'company', 'location', 'startedAt', 'endedAt',
               'current', 'sourceType', 'sourceId', 'correctionOf',
               'supersededBy', 'recordedAt', 'createdAt',
               'immutableProvenance'
             ])
             && data.role is string
             && data.role.size() <= 240
             && data.company is string
             && data.company.size() <= 240
             && data.location is string
             && data.location.size() <= 500
             && (data.startedAt == null || data.startedAt is timestamp)
             && (data.endedAt == null || data.endedAt is timestamp)
             && data.current is bool
             && data.sourceType in [
               'profile', 'profile-backfill', 'import', 'user-correction'
             ]
             && isNullableString(data.sourceId, 300)
             && isNullableString(data.correctionOf, 300)
             && data.supersededBy == null
             && data.recordedAt is timestamp
             && data.createdAt == request.time

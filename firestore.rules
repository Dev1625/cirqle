             && value.feature == feature
             && value.sourceIds is list
             && value.sourceIds.size() <= 50
             && value.sourceLabels is map
             && value.sourceLabels.size() <= 50
             && value.unsupportedAssumptions is list
             && value.unsupportedAssumptions.size() <= 20
             && value.privacyExclusions is list
             && value.privacyExclusions.size() <= 50
             && value.generatedAt is string
             && value.generatedAt.size() <= 64
             && (!('sourceObservedAt' in value)
                 || (value.sourceObservedAt is map

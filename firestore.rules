                 || data.providerSendState in ['reserved', 'completed'])
             && (!('trackerLifecycleStatus' in data)
                 || data.trackerLifecycleStatus in ['active', 'deleted']);
    }

    function browserOutreachProofCreateAllowed(data) {
      return !data.keys().hasAny([

                   'preview-simulated'
                 ])
             && (!('responseReceived' in data)
                 || data.responseReceived == null
                 || data.responseReceived in ['Yes', 'No'])
             && hasOptionalBool(data, 'meetingHeld')
             && hasOptionalBoundedString(data, 'nextAction', 20000)
             && hasOptionalBool(data, 'referralGenerated')
             && data.updatedAt is timestamp
             && (!('generatedBy' in data)
                 || data.generatedBy in ['ai', 'template', 'manual'])
             && (!('aiProvenance' in data)
                 || (data.aiProvenance is map
                     && data.aiProvenance.size() <= 12))
             && (!('replyProvenance' in data)
                 || (data.replyProvenance is map
                     && data.replyProvenance.size() <= 12))
             && (!('replyEvidence' in data)
                 || (data.replyEvidence is map
                     && data.replyEvidence.keys().hasOnly([
                       'occurredAt', 'source', 'sourceRecordId', 'provider',
                       'threadId', 'messageId', 'eventId'

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function accountSecurity(userId) {
      return get(
        /databases/$(database)/documents/_accountSecurity/$(userId)
      );
    }

    function hasActiveAccount(userId) {
      let security = accountSecurity(userId);
      return request.auth != null
             && request.auth.uid == userId
             && request.auth.token.auth_time is int
             && security.data.status == 'active'
             && request.auth.token.auth_time
                > security.data.revokedAfterSeconds;
    }

    function isOwner(userId) {
      return hasActiveAccount(userId);
    }

    function isPublicCardOwner() {
      return request.auth != null
             && request.auth.uid == resource.data.ownerUid
             && hasActiveAccount(resource.data.ownerUid);
    }

    function hasVerifiedEmail() {
      return request.auth != null
             && request.auth.token.email_verified == true;
    }

    function canWritePrivateData(userId) {
      return isOwner(userId) && hasVerifiedEmail();
    }

    // Deliberately `existsAfter`/`getAfter` rather than `exists`/`get`.
    //
    // Adding a contact writes the contact and its derived profile facts in one
    // atomic batch. Rules evaluate each write against *committed* state, so
    // `exists` could not see the contact being created alongside the fact and
    // denied the whole batch — which took out adding a contact at all.
    //
    // The `*After` variants read post-batch state, which is the condition this
    // check actually wants: never leave a fact orphaned from its contact. A
    // fact whose contact neither exists nor is created in the same request is
    // still denied, and a contact fenced for purging in this same batch is now
    // caught too. For any write that does not touch the contact document these
    // behave identically to `exists`/`get`.
    //
    // Every caller is an `allow create`/`allow update`; the `*After` functions
    // are not valid in read rules, so keep it that way.
    function contactAcceptsLinkedWrites(userId, contactId) {
      return contactId is string
             && contactId.size() > 0
             && contactId.size() <= 300
             && existsAfter(
               /databases/$(database)/documents/users/$(userId)/contacts/$(contactId)
             )
             && !(
               'purgeFence' in getAfter(
                 /databases/$(database)/documents/users/$(userId)/contacts/$(contactId)
               ).data
             );
    }

    function linkedContactAcceptsWrites(userId, data) {
      return !('contactId' in data)
             || data.contactId == null
             || contactAcceptsLinkedWrites(userId, data.contactId);
    }

    function connectionAcceptsLinkedWrites(userId, collectionName, data) {
      return collectionName != 'connections'
             || (
               data.sourceId is string
               && data.targetId is string
               && data.sourceId != data.targetId
               && contactAcceptsLinkedWrites(userId, data.sourceId)
               && contactAcceptsLinkedWrites(userId, data.targetId)
             );
    }

    function browserMergeMetadataCreateAllowed(data) {
      return !data.keys().hasAny([
        'contactMergeOperationId', 'migratedFromContactId',
        'migratedFromContactName', 'migratedFromHadContactName',
        'migratedFromPath', 'migratedToPath',
        'originalConnectionEndpoints', 'mergeHistorical',
        'mergeSuppressed', 'mergeRecoverySourceOperationId',
        'migrationRecordedAt'
      ]);
    }

    function browserMergeMetadataUpdateAllowed(collectionName) {
      let changed = request.resource.data.diff(resource.data).affectedKeys();
      let hasRecoveryMarker =
        'contactMergeOperationId' in resource.data;
      return !changed.hasAny([
               'contactMergeOperationId', 'migratedFromContactId',
               'migratedFromContactName', 'migratedFromHadContactName',
               'migratedFromPath', 'migratedToPath',
               'originalConnectionEndpoints', 'mergeHistorical',
               'mergeSuppressed', 'mergeRecoverySourceOperationId',
               'migrationRecordedAt'
             ])
             && (
               !hasRecoveryMarker
               || (
                 collectionName != 'connections'
                 && !changed.hasAny(['contactId'])
               )
             );
    }

    function isValidCardId(cardId) {
      // The application generates ten characters from this ambiguity-free
      // alphabet. Checking both the path and payload prevents aliases and
      // accidental publication under a malformed route.
      return cardId.matches('^[23456789abcdefghjkmnpqrstuvwxyz]{10}$');
    }

    function isNullableString(value, maxLength) {
      return value == null
             || (value is string && value.size() <= maxLength);
    }

    function isSafePublicText(value, maxLength) {
      return value is string
             && value.size() <= maxLength
             && value.matches('^[^\\x00-\\x1F\\x7F]*$');
    }

    function isSafePublicEmail(value) {
      return value == null
             || value == ''
             || (value is string
                 && value.size() <= 320
                 && value.matches(
                   '^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$'
                 ));
    }

    function hasOptionalBoundedString(data, field, maxLength) {
      return !(field in data)
             || isNullableString(data[field], maxLength);
    }

    function isValidPrivateGrounding(value) {
      return value == null
             || (value is map
                 && value.keys().hasOnly([
                   'usedSourceIds', 'unsupportedAssumptions',
                   'privacyExclusions', 'sourceLabels', 'generatedAt',
                   'generation', 'sourceObservedAt',
                   'consideredSourceCount', 'dataFreshThrough'
                 ])
                 && value.usedSourceIds is list
                 && value.usedSourceIds.size() <= 50
                 && value.unsupportedAssumptions is list
                 && value.unsupportedAssumptions.size() <= 20
                 && value.sourceLabels is map
                 && value.sourceLabels.size() <= 50
                 && value.generatedAt is string
                 && value.generatedAt.size() <= 64
                 && (!('sourceObservedAt' in value)
                     || (value.sourceObservedAt is map
                         && value.sourceObservedAt.size() <= 50))
                 && (!('consideredSourceCount' in value)
                     || (value.consideredSourceCount is int
                         && value.consideredSourceCount >= 0
                         && value.consideredSourceCount <= 60))
                 && (!('dataFreshThrough' in value)
                     || isNullableString(value.dataFreshThrough, 64))
                 && (!('privacyExclusions' in value)
                     || (value.privacyExclusions is list
                         && value.privacyExclusions.size() <= 50))
                 && (!('generation' in value)
                     || (value.generation is map
                         && value.generation.size() <= 8)));
    }

    function isValidPrivateCard(value) {
      return value == null
             || (value is map
                 && value.keys().hasOnly([
                   'mode', 'accent', 'layout', 'name', 'role', 'company',
                   'intro', 'portedUrl', 'links', 'email', 'published'
                 ])
                 && value.mode in ['ai', 'custom', 'ported']
                 && value.accent in [
                   'oxblood', 'slate', 'moss', 'brass', 'clay', 'ink'
                 ]
                 && value.layout in ['compact', 'expanded']
                 && isNullableString(value.name, 120)
                 && isNullableString(value.role, 160)
                 && isNullableString(value.company, 160)
                 && isNullableString(value.intro, 240)
                 && (value.portedUrl == null
                     || isSafePublicUrl(value.portedUrl))
                 && value.links is list
                 && value.links.size() <= 6
                 && isNullableString(value.email, 320)
                 && value.published is bool);
    }

    function isValidEventMode(value) {
      return value == null
             || (value is map
                 && value.keys().hasOnly([
                   'active', 'sessionId', 'eventName', 'startedAt',
                   'endedAt', 'source'
                 ])
                 && value.active is bool
                 && isNullableString(value.sessionId, 120)
                 && isNullableString(value.eventName, 160)
                 && (value.startedAt == null || value.startedAt is timestamp)
                 && (value.endedAt == null || value.endedAt is timestamp)
                 && value.source in ['manual', 'calendar']);
    }

    function isValidUserRoot(userId) {
      let data = request.resource.data;
      return data.keys().hasOnly([
               'userId', 'createdAt', 'updatedAt', 'name', 'role',
               'company', 'bio', 'resumeText', 'targetIndustries',
               'cardId', 'card', 'cardAIGrounding', 'eventMode',
               'completedTours', 'hasSeenInitialTour', 'tourProgress'
             ])
             && data.keys().hasAll([
               'userId', 'createdAt', 'updatedAt', 'name', 'role',
               'company', 'bio', 'resumeText', 'targetIndustries'
             ])
             && data.userId == userId
             && data.createdAt is timestamp
             && data.createdAt == resource.data.createdAt
             && data.updatedAt is timestamp
             && data.updatedAt == request.time
             && isNullableString(data.name, 160)
             && isNullableString(data.role, 240)
             && isNullableString(data.company, 240)
             && isNullableString(data.bio, 20000)
             && isNullableString(data.resumeText, 200000)
             && data.targetIndustries is list
             && data.targetIndustries.size() <= 50
             && hasOptionalBoundedString(data, 'cardId', 64)
             && (!('card' in data) || isValidPrivateCard(data.card))
             && (!('cardAIGrounding' in data)
                 || isValidPrivateGrounding(data.cardAIGrounding))
             && (!('eventMode' in data)
                 || isValidEventMode(data.eventMode))
             && (!('completedTours' in data)
                 || (data.completedTours is list
                     && data.completedTours.size() <= 24))
             && (!('hasSeenInitialTour' in data)
                 || data.hasSeenInitialTour is bool)
             && (!('tourProgress' in data)
                 || (data.tourProgress is map
                     && data.tourProgress.size() <= 24));
    }

    function isBoundedPrivateDocument(userId) {
      let data = request.resource.data;
      return data.keys().size() <= 80
             && (!('userId' in data) || data.userId == userId)
             && hasOptionalBoundedString(data, 'name', 240)
             && hasOptionalBoundedString(data, 'email', 320)
             && hasOptionalBoundedString(data, 'normalizedEmail', 320)
             && (!('normalizedEmail' in data)
                 || data.normalizedEmail == data.email)
             && hasOptionalBoundedString(data, 'phone', 80)
             && hasOptionalBoundedString(data, 'company', 240)
             && hasOptionalBoundedString(data, 'role', 240)
             && hasOptionalBoundedString(data, 'location', 500)
             && hasOptionalBoundedString(data, 'subject', 2000)
             && hasOptionalBoundedString(data, 'body', 100000)
             && hasOptionalBoundedString(data, 'content', 200000)
             && hasOptionalBoundedString(data, 'summary', 20000)
             && hasOptionalBoundedString(data, 'notes', 50000)
             && hasOptionalBoundedString(data, 'aiSummary', 20000)
             && (!('profileRevision' in data)
                 || (data.profileRevision is int
                     && data.profileRevision >= 0))
             && (!('tags' in data)
                 || (data.tags is list && data.tags.size() <= 100));
    }

    function hasOptionalTimestamp(data, field) {
      return !(field in data)
             || data[field] == null
             || data[field] is timestamp;
    }

    function hasOptionalBool(data, field) {
      return !(field in data)
             || data[field] == null
             || data[field] is bool;
    }

    function contactProfileKeys() {
      return [
        'name', 'email', 'phone', 'company', 'role', 'location',
        'linkedinUrl', 'summary', 'relationshipTier', 'industry',
        'subIndustry', 'school', 'seniority', 'connectionSource',
        'whyTheyMatter', 'tags'
      ];
    }

    function contactDocumentKeys() {
      return contactProfileKeys().concat([
        'userId', 'normalizedEmail', 'profileRevision',
        'lifecycleStatus', 'archivedAt', 'deletedAt', 'purgeEligibleAt',
        'restoredAt', 'aiAllowed', 'aiAllowedBeforeLifecycle',
        'mergedIntoContactId', 'contactMergeOperationId',
        'mergedFromContactIds', 'createdAt', 'updatedAt',
        'lastContactedAt', 'privacyUpdatedAt', 'bulkOperationId',
        'healthPinned', 'healthPinnedAt',
        'introductionWillingness', 'activeIntroductionRequests',
        'introductionCapacity', 'introductionRequestsLast90Days',
        'lastIntroductionRequestAt', 'introductionStaleAfterDays',
        'introductionConflicts', 'introductionMutualContext',
        'introductionSignalsUpdatedAt',
        'importProvenance', 'aiGrounding', 'capturedVia',
        'captureChannel', 'capturedAt', 'capturedEventName',
        'capturedEventSessionId', 'capturedEventSource',
        'consentToFollowUp', 'consentRecordedAt',
        'privacyNoticeVersion', 'captureProvenance',
        'factSyncPending', 'factSyncAt', 'factSyncRecoveredAt',
        'lastContactMergeRecoveryOperationId', 'purgeFence'
      ]);
    }

    function isValidContactProfile(data) {
      return data.keys().hasAll(contactProfileKeys())
             && data.name is string
             && data.name.size() > 0
             && data.name.size() <= 160
             && data.email is string
             && data.email.size() <= 320
             && data.phone is string
             && data.phone.size() <= 80
             && data.company is string
             && data.company.size() <= 200
             && data.role is string
             && data.role.size() <= 200
             && data.location is string
             && data.location.size() <= 200
             && data.linkedinUrl is string
             && data.linkedinUrl.size() <= 2048
             && data.summary is string
             && data.summary.size() <= 4000
             && data.relationshipTier in ['Cold', 'Warm', 'Strong']
             && data.industry is string
             && data.industry.size() <= 160
             && data.subIndustry is string
             && data.subIndustry.size() <= 160
             && data.school is string
             && data.school.size() <= 200
             && data.seniority is string
             && data.seniority.size() <= 120
             && data.connectionSource is string
             && data.connectionSource.size() <= 240
             && data.whyTheyMatter is string
             && data.whyTheyMatter.size() <= 2000
             && data.tags is list
             && data.tags.size() <= 40;
    }

    // `agent` marks a record written by an AI agent through the MCP server.
    // Those writes go through the Admin SDK, which bypasses these rules
    // entirely — this allowlist exists so the rules still describe every shape
    // that can legitimately exist in the database. A spec that contradicts what
    // is actually stored is how the last round of bugs stayed hidden.
    //
    // `agent` and `csv` are deliberately distinct: it must stay possible to
    // revoke everything an agent wrote without touching the owner's own
    // uploads. See RETENTION_SOURCE_TYPES.
    function isValidContactImportProvenance(value) {
      return value is map
             && value.keys().hasOnly([
               'sourceType', 'sourceId', 'rowId', 'mapping', 'importedAt'
             ])
             && value.keys().hasAll([
               'sourceType', 'sourceId', 'rowId', 'mapping', 'importedAt'
             ])
             && value.sourceType in ['csv', 'agent']
             && value.sourceId is string
             && value.sourceId.size() > 0
             && value.sourceId.size() <= 300
             && isNullableString(value.rowId, 300)
             && value.mapping in ['ai-grounded', 'deterministic']
             && value.importedAt is timestamp;
    }

    function isValidContactCaptureProvenance(value) {
      return value is map
             && value.keys().hasOnly([
               'sourceType', 'sourceId', 'cardId', 'eventSessionId',
               'channel', 'channelEvidence', 'channelVerified'
             ])
             && value.keys().hasAll([
               'sourceType', 'sourceId', 'cardId', 'eventSessionId',
               'channel', 'channelEvidence', 'channelVerified'
             ])
             && value.sourceType == 'public-card'
             && value.sourceId is string
             && value.sourceId.size() > 0
             && value.sourceId.size() <= 300
             && value.cardId is string
             && value.cardId.size() > 0
             && value.cardId.size() <= 64
             && isNullableString(value.eventSessionId, 120)
             && value.channel in ['qr', 'nfc', 'link', 'direct']
             && value.channelEvidence in [
               'client-url-marker', 'unmarked-url'
             ]
             && value.channelVerified == false;
    }

    function isValidContactConflict(value) {
      return value is map
             && value.keys().hasOnly(['id', 'label', 'severity'])
             && value.keys().hasAll(['id', 'label', 'severity'])
             && value.id is string
             && value.id.size() > 0
             && value.id.size() <= 400
             && value.label is string
             && value.label.size() > 0
             && value.label.size() <= 240
             && value.severity in ['warning', 'block'];
    }

    function isValidContactOperationalFields(data) {
      return hasOptionalTimestamp(data, 'lastContactedAt')
             && hasOptionalTimestamp(data, 'privacyUpdatedAt')
             && hasOptionalBool(data, 'healthPinned')
             && hasOptionalTimestamp(data, 'healthPinnedAt')
             && (!('introductionWillingness' in data)
                 || data.introductionWillingness in [
                   'yes', 'likely', 'unknown', 'reluctant', 'no'
                 ])
             && (!('activeIntroductionRequests' in data)
                 || data.activeIntroductionRequests == null
                 || (data.activeIntroductionRequests is int
                     && data.activeIntroductionRequests >= 0
                     && data.activeIntroductionRequests <= 100))
             && (!('introductionCapacity' in data)
                 || data.introductionCapacity == null
                 || (data.introductionCapacity is int
                     && data.introductionCapacity >= 1
                     && data.introductionCapacity <= 100))
             && (!('introductionRequestsLast90Days' in data)
                 || data.introductionRequestsLast90Days == null
                 || (data.introductionRequestsLast90Days is int
                     && data.introductionRequestsLast90Days >= 0
                     && data.introductionRequestsLast90Days <= 500))
             && hasOptionalTimestamp(data, 'lastIntroductionRequestAt')
             && (!('introductionStaleAfterDays' in data)
                 || (data.introductionStaleAfterDays is int
                     && data.introductionStaleAfterDays >= 30
                     && data.introductionStaleAfterDays <= 1825))
             && (!('introductionConflicts' in data)
                 || (data.introductionConflicts is list
                     && data.introductionConflicts.size() <= 1
                     && (data.introductionConflicts.size() == 0
                         || isValidContactConflict(
                           data.introductionConflicts[0]
                         ))))
             && (!('introductionMutualContext' in data)
                 || (data.introductionMutualContext is string
                     && data.introductionMutualContext.size() <= 500))
             && hasOptionalTimestamp(
               data,
               'introductionSignalsUpdatedAt'
             );
    }

    function isValidBrowserContactCreate(userId) {
      let data = request.resource.data;
      return data.keys().hasOnly(contactDocumentKeys())
             && isValidContactProfile(data)
             && data.userId == userId
             && data.normalizedEmail == data.email
             && data.profileRevision == 0
             && data.lifecycleStatus == 'active'
             && data.aiAllowed is bool
             && data.createdAt == request.time
             && data.updatedAt == request.time
             && isValidContactOperationalFields(data)
             && !data.keys().hasAny([
               'archivedAt', 'deletedAt', 'purgeEligibleAt', 'restoredAt',
               'aiAllowedBeforeLifecycle', 'mergedIntoContactId',
               'contactMergeOperationId', 'mergedFromContactIds',
               'bulkOperationId', 'factSyncPending', 'factSyncAt',
               'factSyncRecoveredAt',
               'lastContactMergeRecoveryOperationId', 'purgeFence'
             ])
             && (!('importProvenance' in data)
                 || isValidContactImportProvenance(
                   data.importProvenance
                 ))
             && (!('aiGrounding' in data)
                 || (data.aiGrounding is map
                     && data.aiGrounding.size() <= 12))
             && (!('capturedVia' in data)
                 || data.capturedVia in [
                   'qr-code', 'nfc-card', 'shared-link', 'public-card'
                 ])
             && (!('captureChannel' in data)
                 || data.captureChannel in ['qr', 'nfc', 'link', 'direct'])
             && hasOptionalTimestamp(data, 'capturedAt')
             && hasOptionalBoundedString(data, 'capturedEventName', 160)
             && hasOptionalBoundedString(
               data,
               'capturedEventSessionId',
               120
             )
             && hasOptionalBoundedString(
               data,
               'capturedEventSource',
               80
             )
             && hasOptionalBool(data, 'consentToFollowUp')
             && hasOptionalTimestamp(data, 'consentRecordedAt')
             && hasOptionalBoundedString(
               data,
               'privacyNoticeVersion',
               80
             )
             && (!('captureProvenance' in data)
                 || isValidContactCaptureProvenance(
                   data.captureProvenance
                 ));
    }

    function hasBrowserContactLifecycleTransition() {
      let data = request.resource.data;
      let before = resource.data.get('lifecycleStatus', 'active');
      let after = data.get('lifecycleStatus', 'active');
      return (
               before == 'active'
               && after == 'archived'
               && data.archivedAt is timestamp
               && data.get('deletedAt', null) == null
               && data.get('purgeEligibleAt', null) == null
               && data.get('restoredAt', null) == null
               && data.aiAllowed == false
               && data.aiAllowedBeforeLifecycle is bool
             )
             || (
               before in ['active', 'archived']
               && after == 'deleted'
               && data.deletedAt is timestamp
               && data.purgeEligibleAt is timestamp
               && data.purgeEligibleAt > data.deletedAt
               && data.get('restoredAt', null)
                  == resource.data.get('restoredAt', null)
               && data.aiAllowed == false
               && data.aiAllowedBeforeLifecycle is bool
             )
             || (
               before in ['archived', 'deleted']
               && after == 'active'
               && resource.data.get('mergedIntoContactId', null) == null
               && (
                 before != 'deleted'
                 || (
                   'purgeEligibleAt' in resource.data
                   && request.time < resource.data.purgeEligibleAt
                 )
               )
               && data.get('archivedAt', null) == null
               && data.get('deletedAt', null) == null
               && data.get('purgeEligibleAt', null) == null
               && data.restoredAt is timestamp
               && data.aiAllowed is bool
               && data.get('aiAllowedBeforeLifecycle', null) == null
             );
    }

    function isValidBrowserContactUpdate(userId) {
      let data = request.resource.data;
      let changed = data.diff(resource.data).affectedKeys();
      return data.keys().hasOnly(contactDocumentKeys())
             && data.userId == userId
             && data.userId == resource.data.userId
             && data.createdAt == resource.data.createdAt
             && data.updatedAt == request.time
             && data.profileRevision
                == resource.data.get('profileRevision', 0)
             && !('purgeFence' in resource.data)
             && !('purgeFence' in data)
             && (
               (
                 changed.hasAny(['lifecycleStatus'])
                 && changed.hasOnly([
                   'lifecycleStatus', 'archivedAt', 'deletedAt',
                   'purgeEligibleAt', 'restoredAt', 'aiAllowed',
                   'aiAllowedBeforeLifecycle', 'bulkOperationId',
                   'updatedAt'
                 ])
                 && hasBrowserContactLifecycleTransition()
                 && (
                   !changed.hasAny(['bulkOperationId'])
                   || (
                     data.bulkOperationId is string
                     && exists(
                       /databases/$(database)/documents/users/$(userId)/contactBulkOperations/$(data.bulkOperationId)
                     )
                     && get(
                       /databases/$(database)/documents/users/$(userId)/contactBulkOperations/$(data.bulkOperationId)
                     ).data.actorUid == userId
                     && get(
                       /databases/$(database)/documents/users/$(userId)/contactBulkOperations/$(data.bulkOperationId)
                     ).data.status == 'running'
                     && data.get('lifecycleStatus', 'active') == 'deleted'
                   )
                 )
               )
               || (
                 changed.hasOnly(['lastContactedAt', 'updatedAt'])
                 && data.lastContactedAt is timestamp
               )
               || (
                 changed.hasOnly([
                   'healthPinned', 'healthPinnedAt', 'updatedAt'
                 ])
                 && data.healthPinned is bool
                 && (
                   (data.healthPinned
                    && data.healthPinnedAt is timestamp)
                   || (!data.healthPinned && data.healthPinnedAt == null)
                 )
               )
               || (
                 changed.hasOnly([
                   'introductionWillingness',
                   'activeIntroductionRequests',
                   'introductionCapacity',
                   'introductionRequestsLast90Days',
                   'lastIntroductionRequestAt',
                   'introductionStaleAfterDays',
                   'introductionConflicts',
                   'introductionMutualContext',
                   'introductionSignalsUpdatedAt', 'updatedAt'
                 ])
                 && data.introductionSignalsUpdatedAt == request.time
                 && isValidContactOperationalFields(data)
               )
               || (
                 changed.hasOnly([
                   'aiAllowed', 'privacyUpdatedAt', 'updatedAt'
                 ])
                 && resource.data.get('lifecycleStatus', 'active')
                    == 'active'
                 && data.aiAllowed is bool
                 && data.privacyUpdatedAt == request.time
               )
             );
    }

    function isValidOutreachDocument(userId, data) {
      return data.keys().hasOnly([
               'userId', 'contactId', 'contactName', 'type', 'channel',
               'subject', 'body', 'status', 'verification', 'threadId',
               'nextFollowUpDate', 'responseReceived', 'dateOfResponse',
               'meetingHeld', 'meetingDate', 'nextAction',
               'referralGenerated', 'applicationLinked', 'notes',
               'aiSummary', 'sentAt', 'openedAt', 'userConfirmedAt',
               'createdAt', 'updatedAt', 'templateId', 'generatedBy',
               'aiFeature', 'aiProvenance', 'replyProvenance',
               'replyEvidence', 'responseSource', 'responseThreadId',
               'deliveryMode', 'provider', 'providerSendState',
               'providerRequestDigest', 'providerReservationAt',
               'providerMessageId', 'providerVerifiedAt',
               'trackerLifecycleStatus', 'trackerDeletedAt',
               'trackerPurgeAfter', 'contactMergeOperationId',
               'migratedFromContactId', 'migratedFromContactName',
               'migratedFromHadContactName', 'migratedFromPath',
               'migratedToPath', 'mergeHistorical', 'mergeSuppressed',
               'mergeRecoverySourceOperationId', 'migrationRecordedAt'
             ])
             && data.keys().hasAll([
               'userId', 'contactId', 'type', 'status', 'updatedAt'
             ])
             && data.userId == userId
             && data.contactId is string
             && data.contactId.size() > 0
             && data.contactId.size() <= 300
             && isBoundedPrivateDocument(userId)
             && hasOptionalBoundedString(data, 'contactName', 240)
             && data.type is string
             && data.type.size() > 0
             && data.type.size() <= 120
             && data.status in [
               'Drafted', 'Opened in Mail Client',
               'Sent (User Confirmed)', 'Sent (Provider Verified)',
               'Delivered', 'Responded', 'Pending Follow-Up',
               'Meeting Scheduled', 'Meeting Complete', 'Referred',
               'Closed (Positive)', 'Closed (No Response)', 'Re-engage',

                     && data.introductionCapacity >= 1
                     && data.introductionCapacity <= 10000))
             && (data.introductionRequestsLast90Days == null
                 || (data.introductionRequestsLast90Days is int
                     && data.introductionRequestsLast90Days >= 0
                     && data.introductionRequestsLast90Days <= 10000))
             && (data.lastIntroductionRequestAt == null
                 || data.lastIntroductionRequestAt is timestamp)
             && data.conflicts is list
             && data.conflicts.size() <= 1
             && (data.conflicts.size() == 0
